---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map(r => ({ params: { slug: r.id }, props: { review: r } }));
}
const { review } = Astro.props;
const d = review.data;
const { Content } = await render(review);
---
<Base title={`${d.title} — Movies with Avi`}>
  <style>
    .review { max-width: 780px; margin: 0 auto; padding: 26px 22px 60px; }
    .top { display: grid; grid-template-columns: 220px 1fr; gap: 28px; align-items: start; }
    .top img { border-radius: 14px; box-shadow: 0 10px 30px rgba(142,35,32,.18); }
    h1 { font-size: clamp(1.8rem, 4.4vw, 2.7rem); letter-spacing: -.02em; line-height: 1.06; }
    .date { font-family: var(--font-mono); font-size: .78rem; color: var(--ink-soft); margin: 8px 0 12px; }
    .verdict { font-family: var(--font-display); font-weight: 600; font-size: .95rem; margin-top: 8px; color: var(--seat-deep); }
    .one { font-style: italic; font-size: 1.08rem; margin-top: 14px; color: var(--ink-soft); }
    .catline { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 7px; }
    .catline a { font-family: var(--font-display); font-weight: 600; font-size: .78rem; text-decoration: none; background: #fff; border: 1.5px solid rgba(42,30,27,.15); padding: 5px 12px; border-radius: 999px; color: var(--ink-soft); }
    .sec { margin-top: 30px; }
    .lab { font-family: var(--font-mono); font-size: .72rem; font-weight: 600; letter-spacing: .16em; color: var(--seat-red); }
    .sec .body { margin-top: 8px; font-size: 1.04rem; }
    .back { display: inline-block; margin-top: 40px; font-family: var(--font-display); font-weight: 700; text-decoration: none; }
    @media (max-width: 640px) { .top { grid-template-columns: 1fr; } .top img { max-width: 260px; } }
  </style>
  <article class="review">
    <div class="top">
      {d.image && <img src={d.image} alt={`Poster for ${d.title}`} />}
      <div>
        <h1>“{d.title}”</h1>
        <div class="date">{d.date}</div>
        {d.ratingNum != null && (
          <span class="cells">
            {[0,1,2,3].map(i => (
              <span class="cell"><i style={`width:${Math.max(0, Math.min(1, d.ratingNum - i)) * 100}%`}></i></span>
            ))}
            <span class="rnum">{d.ratingNum.toFixed(2)} / 4</span>
          </span>
        )}
        {d.rating && <div class="verdict">{d.rating.replace(/^[\d.]+\/4\s*/, '')}</div>}
        {d.oneLine && <p class="one">{d.oneLine}</p>}
        <div class="catline">
          {d.categories.map(c => <a href={`/browse/?cat=${encodeURIComponent(c)}`}>{c}</a>)}
        </div>
      </div>
    </div>

    <div class="sec"><span class="lab">THE DEETS</span><div class="body"><Content /></div></div>
    {d.perfectFor && <div class="sec"><span class="lab">PERFECT FOR</span><div class="body">{d.perfectFor}</div></div>}
    {d.whereToWatch && <div class="sec"><span class="lab">WHERE TO WATCH</span><div class="body">{d.whereToWatch}</div></div>}
    {d.foodPairing && <div class="sec"><span class="lab">FOOD PAIRING</span><div class="body">{d.foodPairing}</div></div>}

    <div class="react" id="react" data-slug={review.id}>
      <button class="react-btn" id="react-btn" aria-label="I'd watch this">
        <span class="corn">🍿</span>
      </button>
      <div class="react-meta">
        <span class="react-count" id="react-count">–</span>
        <span class="react-label">“I’d watch this”</span>
      </div>
    </div>

    <a class="back" href="/browse/">← Back to the library</a>
  </article>

  <style>
    .react { margin-top: 44px; display: flex; align-items: center; gap: 16px; padding: 20px 22px;
      background: #fff; border: 2px solid rgba(42,30,27,.1); border-radius: 16px; }
    .react-btn { border: none; background: var(--seat-red, #C0392E); color: #fff; width: 62px; height: 62px;
      border-radius: 50%; font-size: 1.7rem; cursor: pointer; line-height: 1; display: grid; place-items: center;
      box-shadow: 0 6px 16px rgba(192,57,46,.34); transition: transform .08s ease; -webkit-tap-highlight-color: transparent; }
    .react-btn:active { transform: scale(.9); }
    .react-btn.pop { animation: pop .32s ease; }
    @keyframes pop { 0%{transform:scale(1)} 40%{transform:scale(1.22)} 100%{transform:scale(1)} }
    .react-meta { display: flex; flex-direction: column; }
    .react-count { font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; line-height: 1; color: var(--seat-deep, #2A1E1B); }
    .react-label { font-family: var(--font-mono); font-size: .74rem; letter-spacing: .06em; color: var(--ink-soft); margin-top: 3px; }
    .floaters { position: relative; }
    .floater { position: absolute; pointer-events: none; font-size: 1.1rem; animation: rise .8s ease-out forwards; }
    @keyframes rise { 0%{opacity:1; transform: translateY(0) scale(.8)} 100%{opacity:0; transform: translateY(-46px) scale(1.2)} }
  </style>

  <script>
    (function () {
      const wrap = document.getElementById('react');
      if (!wrap) return;
      const slug = wrap.dataset.slug;
      const btn = document.getElementById('react-btn');
      const countEl = document.getElementById('react-count');
      let count = 0, pending = 0, timer = null;

      fetch('/api/reactions?slugs=' + encodeURIComponent(slug))
        .then(r => r.json()).then(d => { count = d[slug] || 0; countEl.textContent = count.toLocaleString(); })
        .catch(() => { countEl.textContent = '0'; });

      function flush() {
        const n = pending; pending = 0; timer = null;
        if (!n) return;
        fetch('/api/react', { method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, n }) })
          .then(r => r.json()).then(d => { if (typeof d.count === 'number') { count = d.count; countEl.textContent = count.toLocaleString(); } })
          .catch(() => {});
      }
      function floater() {
        const f = document.createElement('span');
        f.className = 'floater'; f.textContent = '🍿';
        f.style.left = (14 + Math.random() * 34) + 'px'; f.style.top = '0px';
        btn.appendChild(f); setTimeout(() => f.remove(), 800);
      }
      btn.classList.add('floaters');
      btn.addEventListener('click', () => {
        count++; pending++;
        countEl.textContent = count.toLocaleString();
        btn.classList.remove('pop'); void btn.offsetWidth; btn.classList.add('pop');
        floater();
        clearTimeout(timer); timer = setTimeout(flush, 600); // batch rapid taps into one request
      });
    })();
  </script>
</Base>
