# Required — your Anthropic API key. Never commit the real value.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional — shared password. If set, the app asks for it before it will
# spend your API key. Anything deployed to a public URL should set this.
APP_PASSWORD=

# Optional — defaults shown.
ASSISTANT_MODEL=claude-opus-5
JUDGE_MODEL=claude-opus-5
PORT=3000
RATE_LIMIT_PER_MIN=40
